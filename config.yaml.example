family:
  members:
    - id: alex
      name: Alex
      role: adult
      # Optional: private Telegram chat id for this member (or use /link alex in a DM)
      # telegram_chat_id: 123456789
      calendar:
        provider: google
        email: your.email@gmail.com   # Google account for this member's calendar
      # Optional daily targets (omit any field you don't care about)
      nutrition_goals:
        calories: 2200
        protein_g: 160
        carbs_g: 220
        fats_g: 70
        fiber_g: 30
        steps: 10000   # daily step push (late sync ~11pm ET nudges if under)
      # Optional long-horizon fitness outcome + training policy.
      # Keep real goals in your private config.yaml (gitignored) — never commit
      # personal health details. Linked Telegram DMs only see *your* nutrition/training.
      fitness_goals:
        intent: "example outcome (replace locally)"
        target_date: "2027-06-01"
        focus: "recomp"             # cut | bulk | recomp | endurance | general
        sessions_per_week: 4
        session_minutes: 45
        equipment: "gym"            # home | gym | mixed
        # User-authored limits only (NOT medical records / diagnoses).
        constraints:
          - "example constraint (replace locally)"
        weekly_targets:
          strength_sessions: 3
          cardio_minutes: 90
          active_calories: 400      # daily floor when set
    - id: jordan
      name: Jordan
      role: adult
      # telegram_chat_id: 987654321
      calendar:
        provider: google
        email: other.email@gmail.com
      nutrition_goals:
        calories: 1800
        protein_g: 120
    - id: sam
      name: Sam
      role: kid
      # no calendar / nutrition_goals / fitness_goals / telegram = no calendar / goals / personal DM

# Note: Per-member Google Calendar refresh tokens are stored in .env, not here.
# After running /login calendar <member_id> in Telegram, the following will be
# automatically added to your .env:
#   CALENDAR_REFRESH_TOKEN_ALEX=...
#   CALENDAR_REFRESH_TOKEN_JORDAN=...
#
# Per-member Telegram DMs: each adult DMs the bot and runs `/link <member_id>`.
# That writes `telegram_chat_id` here. `/link` will not overwrite a member already
# linked to a different chat — clear `telegram_chat_id` first to move. Household
# pushes (brief, budgets, stock, reflection) fan out to all linked chats;
# `TELEGRAM_CHAT_ID` remains an optional shared fallback. Once any member is
# linked, unknown chats are rejected.
#
# Optional: CHOTU_TIMEZONE=America/Toronto (used when auto-scheduling tasks/bills)

currency: "CAD"
email_classifier_prompt_path: "prompts/email_classifier_system_prompt.txt"

# Optional household category spend budgets (base currency). Telegram `/budget set`
# overrides these; 80%/100% Telegram alerts fan out to linked DMs (and
# TELEGRAM_CHAT_ID if set).
spend_budgets:
  categories:
    Food: 800
    Shopping: 400
    Entertainment: 200
    Subscription: 150

investment_philosophy:
  description: "finding high-conviction micro-cap and small-cap stocks with potential for 100x returns ('hundred baggers')"
  focus_areas:
    - "Massive market opportunity"
    - "Strong unit economics / high return on capital"
    - "Strong competitive advantage (moats)"
    - "Excellent capital allocation by management"

target_allocation:
  monthly_budget: 3000
  buckets:
    - name: "Core Equities"
      weight_percent: 50.0
      monthly_buy: 1500
      holdings:
        - { ticker: "VFV", amount: 1000 }
        - { ticker: "QQC", amount: 500 }
    - name: "Tactical Satellite"
      weight_percent: 50.0
      monthly_buy: 1500
      holdings:
        - { ticker: "CACI", amount: 750 }
        - { ticker: "FIG", amount: 750 }
