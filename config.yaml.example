family:
  members:
    - id: alex
      name: Alex
      role: adult
      # Optional: private Telegram chat id for this member (or use /link alex in a DM)
      # telegram_chat_id: 123456789
      calendar:
        provider: google
        email: your.email@gmail.com   # Google account for this member's calendar
      # Optional daily targets (omit any field you don't care about)
      nutrition_goals:
        calories: 2200
        protein_g: 160
        carbs_g: 220
        fats_g: 70
        fiber_g: 30
        steps: 10000   # daily step push (late sync ~11pm ET nudges if under)
      # Optional long-horizon fitness outcome + training policy.
      # Keep real goals in your private config.yaml (gitignored) — never commit
      # personal health details. Linked Telegram DMs only see *your* nutrition/training.
      fitness_goals:
        intent: "example outcome (replace locally)"
        target_date: "2027-06-01"
        focus: "recomp"             # required enum if set: cut | bulk | recomp | endurance | general
        sessions_per_week: 4
        session_minutes: 45
        equipment: "gym"            # required enum if set: home | gym | mixed
        # User-authored limits only (NOT medical records / diagnoses).
        constraints:
          - "example constraint (replace locally)"
        weekly_targets:
          strength_sessions: 3
          cardio_minutes: 90
          # Daily minimum Google Health "active energy burned" (movement/workout kcal),
          # NOT food-intake calories. Omit if you don't care about this floor.
          active_calories: 400
      # Optional chronic conditions (definitions only). Watchlists and scores
      # live in local SQLite — never commit real diagnoses. Empty list is fine.
      # health_conditions:
      #   - id: psoriasis
      #     label: "plaque psoriasis"
      #     check_in: true            # evening /reflect asks 0–5
      #     lag_window: [1, 3]        # food tags from 1–3 days prior
      #     notes: "example notes (replace locally)"
    - id: jordan
      name: Jordan
      role: adult
      # telegram_chat_id: 987654321
      calendar:
        provider: google
        email: other.email@gmail.com
      nutrition_goals:
        calories: 1800
        protein_g: 120
    - id: sam
      name: Sam
      role: kid
      # no calendar / nutrition_goals / fitness_goals / telegram = no calendar / goals / personal DM

# Note: Per-member Google Calendar refresh tokens are stored in .env, not here.
# After running /login calendar <member_id> in Telegram, the following will be
# automatically added to your .env:
#   CALENDAR_REFRESH_TOKEN_ALEX=...
#   CALENDAR_REFRESH_TOKEN_JORDAN=...
#
# Per-member Telegram DMs: each adult DMs the bot and runs `/link <member_id>`.
# That writes `telegram_chat_id` here. `/link` will not overwrite a member already
# linked to a different chat — clear `telegram_chat_id` first to move. Household
# pushes (brief, budgets, stock, reflection) fan out to all linked chats;
# `TELEGRAM_CHAT_ID` remains an optional shared fallback. Once any member is
# linked, unknown chats are rejected.
#
# IANA tz database name (https://www.iana.org/time-zones), e.g. America/Toronto.
# The agent uses this for civil clocks (schedules, "3pm", calendar 09:00 blocks).
# Instants written to SQLite are UTC. `CHOTU_TIMEZONE` is a fallback if this is omitted.
timezone: America/Toronto

# 24-hour HH:MM in `timezone`. Omit a key or leave it blank to disable that job.
schedules:
  morning_brief: "07:00"
  portfolio: "18:00"
  reflection: "21:00"
  health_evening_sync: "20:45"
  health_late_steps: "23:00"

currency: "CAD"
email_classifier_prompt_path: "prompts/email_classifier_system_prompt.txt"

# Optional: two core values that shape evening /reflect prompts (alongside health logs).
# Prefer exactly two anchors; nest courage/humility as tools. Integrity = alignment sensor.
# core_values:
#   anchors:
#     - name: Growth
#       definition: "Valuing not knowing and becoming better than yesterday."
#     - name: Contribution
#       definition: "Serving the situation and people; speaking up when silence withholds."
#   integrity_note: "Integrity connects actions to the two anchors; courage fuels Growth."
#   practices:
#     - "Did I leave anything unspoken that sits heavy in my body?"
#     - "Ego autopsy — what was ego protecting?"

# Optional household category spend budgets (base currency). Telegram `/budget set`
# overrides these; 80%/100% Telegram alerts fan out to linked DMs (and
# TELEGRAM_CHAT_ID if set).
spend_budgets:
  categories:
    Food: 800
    Shopping: 400
    Entertainment: 200
    Subscription: 150

investment_philosophy:
  description: "finding high-conviction micro-cap and small-cap stocks with potential for 100x returns ('hundred baggers')"
  focus_areas:
    - "Massive market opportunity"
    - "Strong unit economics / high return on capital"
    - "Strong competitive advantage (moats)"
    - "Excellent capital allocation by management"

target_allocation:
  monthly_budget: 3000
  buckets:
    - name: "Core Equities"
      weight_percent: 50.0
      monthly_buy: 1500
      holdings:
        - { ticker: "VFV", amount: 1000 }
        - { ticker: "QQC", amount: 500 }
    - name: "Tactical Satellite"
      weight_percent: 50.0
      monthly_buy: 1500
      holdings:
        - { ticker: "CACI", amount: 750 }
        - { ticker: "FIG", amount: 750 }
